# Reuse the existing Bitwarden-backed S3 credentials and common variables.
source_env ../portainer/.envrc

export TF_VAR_arcane_endpoint="https://arcane.your-domain.com/api"
# Store the Arcane API key as the password of this Bitwarden item first.
export ARCANE_API_KEY="$(bw get password 'Homelab - Arcane API')"

# Enable only after the pilot Compose file has been merged to main.
# export TF_VAR_enable_pilot="true"

# Enable only after the HandBrake Portainer stack has been removed.
# export TF_VAR_enable_handbrake="true"

# Enable only after the NetbootXYZ Portainer stack has been removed.
# export TF_VAR_enable_netbootxyz="true"

# Enable only after the Beszel Portainer stack has been removed.
# The existing TF_VAR_beszel_public_key is sourced from ../portainer/.envrc.
# export TF_VAR_enable_beszel="true"

# Enable only after the IT Tools Portainer stack has been removed.
# export TF_VAR_enable_it_tools="true"

# Enable only after the MeTube Portainer stack has been removed.
# export TF_VAR_enable_metube="true"

# Enable only after the Ombi Portainer stack has been removed.
# export TF_VAR_enable_ombi="true"

# Enable only after the Home Assistant Portainer stack has been removed.
# export TF_VAR_enable_home_assistant="true"

# Enable only after the dh02 Netdata Portainer stack has been removed.
# The existing TF_VAR_netdata_claim_token is sourced from ../portainer/.envrc.
# export TF_VAR_enable_netdata="true"

# Enable only after the dh02 Watchtower Portainer stack has been removed.
# export TF_VAR_enable_watchtower="true"
# The cleanup setting defaults to "true".
# export TF_VAR_watchtower_cleanup="true"

# Enable only after the dh02 Stirling PDF Portainer stack has been removed.
# The existing TF_VAR_stirling_security_initiallogin_password is sourced from ../portainer/.envrc.
# export TF_VAR_enable_stirling_pdf="true"

# Enable only after the dh02 Gitea Mirror Portainer stack has been removed.
# The existing TF_VAR_better_auth_secret is sourced from ../portainer/.envrc.
# export TF_VAR_enable_gitea_mirror="true"

# Enable only after the dh02 Gitea Portainer stack has been removed.
# The Gitea database settings and password are sourced from ../portainer/.envrc.
# export TF_VAR_enable_gitea="true"

# Enable only after the dh02 Homarr Portainer stack has been removed.
# The existing TF_VAR_homarr_secret_encryption_key is sourced from ../portainer/.envrc.
# export TF_VAR_enable_homarr="true"

# Enable only after the dh02 Rackula Portainer stack has been removed.
# Rackula secret variables are sourced from ../portainer/.envrc.
# export TF_VAR_enable_rackula="true"

# Enable only after the dh02 Hermes Agent Portainer stack has been removed.
# Hermes settings and secrets are sourced from ../portainer/.envrc.
# export TF_VAR_enable_hermes_agent="true"

# Enable only after the dh02 Mail Archiver Portainer stack has been removed.
# Mail Archiver settings and secrets are sourced from ../portainer/.envrc.
# export TF_VAR_enable_mail_archiver="true"

# Enable only after the dh02 Plex Portainer stack has been removed.
# The existing TF_VAR_plex_claim is sourced from ../portainer/.envrc.
# export TF_VAR_enable_plex="true"
