DOCKER_BASE_PATH=/docker
PUID=1000
PGID=1000
TZ=America/Los_Angeles

# Pinned azerothcore-wotlk commit SHA (full 40 characters); bump manually
AC_REF=d5e818f28ee80f5a39115c3bbaa695a6f859303e
# mod-guild-discord branch, tag, or commit to compile in
MOD_GUILD_DISCORD_REF=master

# Generate with: openssl rand -base64 32
AZEROTHCORE_DB_ROOT_PASSWORD=your_secure_db_password_here

# Discord bot token for the discord-relay sidecar (Developer Portal -> Bot -> Reset Token)
AZEROTHCORE_DISCORD_TOKEN=your_discord_bot_token_here
# Password of the scoped discord_relay MySQL account (see README)
AZEROTHCORE_DISCORD_RELAY_DB_PASSWORD=your_secure_relay_db_password_here
